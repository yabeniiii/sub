# =========================
# Rust / Cargo
# =========================

# Build artifacts
target/

# Rust analyzer
**/.rust-analyzer/

# rustfmt backups
**/*.rs.bk

# =========================
# Embedded firmware
# =========================

# Debug probe / flashing tools
**/.probe-rs/
**/.cargo/.cache

# ELF/binary output
**/*.elf
**/*.bin
**/*.hex
**/*.uf2
**/*.map

# Linker output
**/*.lst

# =========================
# Buildroot
# =========================

# Buildroot output (large generated tree)
buildroot/output/

# Buildroot downloads
buildroot/dl/

# Buildroot host tools
buildroot/host/

# Buildroot staging/target dirs
buildroot/staging/
buildroot/target/

# Buildroot temporary files
buildroot/tmp/

# =========================
# FreeCAD
# =========================

# FreeCAD backup files
**/*.FCBak
**/*.FCStd1
**/*.FCStd2

# Autosave files
**/*.autosave
**/*.FCStd.autosave

# Recovery files
**/*.recover

# FreeCAD temporary files
**/~*
**/*.tmp

# Thumbnails generated by FreeCAD
**/.thumbnails/
**/thumbnails/

# FreeCAD cache/config directories
**/.FreeCAD/
**/FreeCAD/

# Generated meshes / exports (keep source models)
**/*.stl
**/*.obj
**/*.amf

# Common CAD interchange exports
**/*.step
**/*.stp
**/*.iges
**/*.igs

# Generated drawings/exports (optional)
**/*.dxf
**/*.svg

# =========================
# KiCad
# =========================

# KiCad generated files
**/*.kicad_prl
**/*.kicad_pro-bak
**/*.kicad_sch-bak
**/*.kicad_pcb-bak

# KiCad autosave
**/*.lck

# Gerber/drill output
**/gerbers/
**/gerber/
**/drill/
**/fabrication/
**/sub-backups/

# 3D viewer cache
**/*.wrl

